# ============================================================
#  Unity .gitignore  (last day / prototype project)
# ============================================================

# ---------- Unity generated folders ----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta files must be committed, except when the asset itself is ignored.
!/[Aa]ssets/**/*.meta

# ---------- Autogenerated / IDE ----------
/[Aa]ssets/AssetStoreTools*
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt
crashlytics-build.properties
.vs/
.idea/
.vscode/

# ---------- Build outputs ----------
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dll.mdb

# ---------- Addressables ----------
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ============================================================
#  Project-specific exclusions
# ============================================================

# Large in-project snapshot taken before the cleanup. It contains a full
# copy of the third-party extracted assets plus an unverified marker file,
# so it must never be committed.
/.baseline-backups/

# Analysis / review artefacts: generated reports, backup folders and
# copied managed DLLs. Reproducible, not source.
/OptimizationReview/

# ============================================================
#  Third-party extracted assets
# ============================================================
# The extracted FBX/PNG set was moved out of the project into an external
# quarantine. These patterns are a safety net so that a future accidental
# re-import of that third-party content cannot be committed.
#
# NOTE: the *Materials* folders inside these paths are original project
# assets and must stay tracked, so only model/texture extensions are ignored.
/Assets/_Project/Art/Environment/Props/Rocks/*.fbx
/Assets/_Project/Art/Environment/Props/Containers/*.fbx
/Assets/_Project/Art/Environment/Props/Furniture/*.fbx
/Assets/_Project/Art/Environment/Props/Vehicles/*.fbx
/Assets/_Project/Art/Environment/Props/Weapons/*.fbx
/Assets/_Project/Art/Environment/Vegetation/*.fbx
/Assets/_Project/Art/Environment/Buildings/*.fbx
/Assets/_Project/Art/Characters/*.fbx
/Assets/_Project/Art/Textures/Extracted/*.png
/Assets/_Project/Art/Textures/Extracted_manifest.json
